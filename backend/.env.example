# Ornek ortam degiskenleri.
# Bu dosyayi backend/.env olarak kopyalayip gercek degerleri girin. .env git'e EKLENMEZ.
#
# Guvenli uretim ornegi (PowerShell):
#   $rng=[Security.Cryptography.RandomNumberGenerator]::Create()
#   $b=New-Object byte[] 64; $rng.GetBytes($b); [Convert]::ToBase64String($b)

DB_URL=jdbc:postgresql://127.0.0.1:5432/envato_bank
DB_USERNAME=bank_app
DB_PASSWORD=change-me

# HS512 icin en az 64 byte base64
JWT_SECRET=base64-encoded-64-bytes

# AES-256-GCM icin 32 byte base64
PII_ENCRYPTION_KEY=base64-encoded-32-bytes

# HMAC-SHA256 blind index icin 32 byte base64
PII_INDEX_KEY=base64-encoded-32-bytes
