<UserControl x:Class="EnvatoBank.Desktop.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EnvatoBank.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TransferViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Para Transferi" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,22" TextWrapping="Wrap"
                           Text="Kaynak hesabınızdan aynı para birimindeki başka bir hesaba transfer yapın. İşlem atomiktir ve idempotent anahtarla güvence altındadır."/>

                <TextBlock Text="Kaynak Hesap" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SourceAccount}"
                          MinHeight="34" VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding AccountNo}"/>
                                <Run Text="  ·  "/>
                                <Run Text="{Binding Balance}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Hedef Hesap No" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                <TextBox Text="{Binding TargetAccountNo, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Tutar (TRX biçimi: 125,50)" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Açıklama (opsiyonel)" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,14,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="0,14,0,0"/>

                <Button Content="Transferi Gönder" Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                        Margin="0,22,0,0" Padding="22,8"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
