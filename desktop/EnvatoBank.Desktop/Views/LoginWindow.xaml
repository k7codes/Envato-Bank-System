<Window x:Class="EnvatoBank.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EnvatoBank.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Envato Bank — Giriş" Height="560" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource BrushBg}">
    <Grid>
        <Border Style="{StaticResource Card}" Margin="28" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Envato Bank" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
                <TextBlock Text="İnternet Bankacılığı" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <TextBlock Text="E-posta" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="Parola" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged"
                             Style="{StaticResource FormPasswordBox}"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" Margin="0,14,0,0"/>

                <Button Content="Giriş Yap" Command="{Binding LoginCommand}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"/>

                <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap"
                           Text="Demo hesapları — Müşteri: ayse@example.com / Demo!2345 · Personel: employee@envatobank.local / Employ!2345"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
