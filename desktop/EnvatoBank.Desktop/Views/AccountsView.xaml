<UserControl x:Class="EnvatoBank.Desktop.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EnvatoBank.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccountsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hesaplarım" Style="{StaticResource H1}" Margin="0,0,0,16"/>

        <DataGrid x:Name="AccountsGrid" Grid.Row="1"
                  ItemsSource="{Binding Accounts}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  Background="{StaticResource BrushCard}"
                  BorderBrush="{StaticResource BrushBorder}"
                  MouseDoubleClick="OnRowDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hesap No" Binding="{Binding AccountNo}" Width="2*"/>
                <DataGridTextColumn Header="Tür" Binding="{Binding Type}" Width="*"/>
                <DataGridTextColumn Header="Para Birimi" Binding="{Binding Currency}" Width="*"/>
                <DataGridTextColumn Header="Bakiye" Binding="{Binding Balance}" Width="1.5*"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Yenile" Command="{Binding ReloadCommand}"
                        Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="Ekstreyi Gör" Command="{Binding OpenStatementCommand}"
                        Style="{StaticResource PrimaryButton}" Padding="16,6"/>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
