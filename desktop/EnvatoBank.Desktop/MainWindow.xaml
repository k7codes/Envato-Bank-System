<Window x:Class="EnvatoBank.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EnvatoBank.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Envato Bank" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource BrushBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushPrimary}">
            <Grid Margin="18,0">
                <TextBlock Text="Envato Bank" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserLine}" Foreground="#D7E1EC" VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button Content="Çıkış" Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12">
                    <Button Content="Hesaplarım" Command="{Binding ShowAccountsCommand}"
                            Style="{StaticResource NavButton}"/>
                    <Button Content="Para Transferi" Command="{Binding ShowTransferCommand}"
                            Style="{StaticResource NavButton}"/>
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="20"/>
        </Grid>
    </Grid>
</Window>
